# =====================================================================
# FB Webhook server — environment template
# Copy to /opt/fb-webhook/.env on VPS and fill in real values.
# =====================================================================

# --- Facebook App (developers.facebook.com → My Apps → Settings → Basic) ---
FB_APP_ID=
FB_APP_SECRET=

# --- Page (Graph API Explorer → exchange to never-expire Page Token) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Webhook verification (you choose this string, must match value in
#     developers.facebook.com → Webhooks → Edit Subscription → Verify Token) ---
FB_VERIFY_TOKEN=change-me-to-a-long-random-string

# --- LLM provider ---
# Works with OpenAI directly or any OpenAI-compatible gateway
# (OpenRouter, DeepSeek, cx.ai, LiteLLM, vLLM, Ollama, …). Set
# OPENAI_BASE_URL to the gateway's /v1 endpoint when using a proxy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Examples:
#   OpenAI     : https://api.openai.com/v1        (model: gpt-4o-mini)
#   DeepSeek   : https://api.deepseek.com         (model: deepseek-chat)
#   OpenRouter : https://openrouter.ai/api/v1     (model: openrouter/...)
#   cx.ai      : https://api.cx.ai/v1             (model: cx/gpt-5.5)
#   LiteLLM    : http://127.0.0.1:4000/v1
#   Ollama     : http://127.0.0.1:11434/v1        (model: llama3.1:8b)

# --- Local services ---
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://fbwebhook:fbwebhook@127.0.0.1:5432/fbwebhook

# --- Behaviour ---
# Safety: start in dry-run; flip to true after testing
AUTO_REPLY_ENABLED=false
# Send draft replies to a Telegram chat for human approval before sending
HUMAN_REVIEW_QUEUE=true

# --- Comment moderation ---
# Each setting is a comma-separated subset of:
#   positive | neutral | question | negative | spam_toxic
# Defaults are conservative: only spam/toxic gets auto-hidden, both
# negative + spam_toxic get forwarded to the admin Telegram, and only
# spam_toxic skips auto-reply (so legitimate complaints still get a
# courteous response).
COMMENT_AUTO_HIDE_LABELS=spam_toxic
COMMENT_FORWARD_LABELS=negative,spam_toxic
COMMENT_SKIP_REPLY_LABELS=spam_toxic
# Minimum LLM confidence (0-1) required before acting on hide/skip.
# Below this, the comment is treated as "neutral".
COMMENT_ACTION_MIN_CONFIDENCE=0.6

# --- Telegram admin bot ---
# Create with @BotFather → /newbot. Token below.
TELEGRAM_BOT_TOKEN=
# Your Telegram chat_id (find via @userinfobot, or send /whoami to your
# bot the first time). Only this id can run /post and other admin commands.
TELEGRAM_ADMIN_CHAT_ID=
# Random string echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Generate with `openssl rand -hex 32`. Must match the value used
# in setWebhook().
TELEGRAM_WEBHOOK_SECRET=

# (Legacy review-only fields, kept for backwards compat.)
TELEGRAM_REVIEW_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=

# Logging
LOG_LEVEL=INFO
