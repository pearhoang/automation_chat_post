# =====================================================================
# FB Webhook server — environment template
# Copy to /opt/fb-webhook/.env on VPS and fill in real values.
# =====================================================================

# --- Facebook App (developers.facebook.com → My Apps → Settings → Basic) ---
FB_APP_ID=
FB_APP_SECRET=

# --- Page (Graph API Explorer → exchange to never-expire Page Token) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Webhook verification (you choose this string, must match value in
#     developers.facebook.com → Webhooks → Edit Subscription → Verify Token) ---
FB_VERIFY_TOKEN=change-me-to-a-long-random-string

# --- LLM provider ---
# Works with OpenAI directly or any OpenAI-compatible gateway
# (OpenRouter, cx.ai, LiteLLM, vLLM, Ollama, …). Set OPENAI_BASE_URL
# to the gateway's /v1 endpoint when using a proxy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Examples:
#   OpenRouter : https://openrouter.ai/api/v1     (model: openrouter/...)
#   cx.ai      : https://api.cx.ai/v1             (model: cx/gpt-5.5)
#   LiteLLM    : http://127.0.0.1:4000/v1
#   Ollama     : http://127.0.0.1:11434/v1        (model: llama3.1:8b)

# --- Local services ---
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://fbwebhook:fbwebhook@127.0.0.1:5432/fbwebhook

# --- Behaviour ---
# Safety: start in dry-run; flip to true after testing
AUTO_REPLY_ENABLED=false
# Send draft replies to a Telegram chat for human approval before sending
HUMAN_REVIEW_QUEUE=true
TELEGRAM_REVIEW_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=

# Logging
LOG_LEVEL=INFO
